<resources>
    <style name="TextAppearance.MaxCorp.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.SplashTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/mc_white</item>
        <item name="android:textSize">31sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.SplashBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">#E7F6FF</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.Subtitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/mc_text_soft</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.StepTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.SectionLabel" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/mc_text_soft</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MaxCorp.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.BodySoft" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/mc_text_soft</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.MaxCorp.FieldValue" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="Widget.MaxCorp.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/mc_card</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/mc_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MaxCorp.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">58dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/mc_white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MaxCorp.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/mc_primary_dark</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MaxCorp.Button.Menu" parent="Widget.MaxCorp.Button.Primary">
        <item name="android:minHeight">62dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.MaxCorp.Button.MenuSecondary" parent="Widget.MaxCorp.Button.Secondary">
        <item name="android:minHeight">60dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.MaxCorp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/mc_white</item>
        <item name="boxStrokeColor">@color/mc_line_strong</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="hintTextColor">@color/mc_text_soft</item>
        <item name="android:textColorHint">@color/mc_text_soft</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
    </style>

    <style name="Widget.MaxCorp.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>
</resources>

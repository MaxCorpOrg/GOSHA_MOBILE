<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/mc_primary_dark"
                android:startColor="@color/mc_primary" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/mc_primary"
                android:startColor="@color/mc_primary_light" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>

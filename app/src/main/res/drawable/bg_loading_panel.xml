<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:endColor="#10254A"
                android:startColor="#295B9A" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <item
        android:gravity="top|center_horizontal"
        android:top="-18dp">
        <shape android:shape="oval">
            <size
                android:width="260dp"
                android:height="120dp" />
            <gradient
                android:centerColor="#47BFEFFF"
                android:endColor="#00BFEFFF"
                android:gradientRadius="130dp"
                android:startColor="#80F6FDFF"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:left="22dp"
        android:top="24dp">
        <shape android:shape="oval">
            <size
                android:width="18dp"
                android:height="18dp" />
            <solid android:color="#4DFFF3B2" />
        </shape>
    </item>

    <item
        android:right="34dp"
        android:top="46dp"
        android:gravity="top|right">
        <shape android:shape="oval">
            <size
                android:width="10dp"
                android:height="10dp" />
            <solid android:color="#66D6F7FF" />
        </shape>
    </item>

    <item
        android:bottom="18dp"
        android:right="28dp"
        android:gravity="bottom|right">
        <shape android:shape="oval">
            <size
                android:width="14dp"
                android:height="14dp" />
            <solid android:color="#59FFF0AE" />
        </shape>
    </item>
</layer-list>

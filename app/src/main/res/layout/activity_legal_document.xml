<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_playful_screen"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvLegalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/legal_document_title_default"
        style="@style/TextAppearance.MaxCorp.ScreenTitle" />

    <TextView
        android:id="@+id/tvLegalSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/legal_document_subtitle_default"
        style="@style/TextAppearance.MaxCorp.Subtitle" />

    <TextView
        android:id="@+id/tvLegalStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_playful_field"
        android:padding="14dp"
        android:text="@string/legal_document_status_loading"
        style="@style/TextAppearance.MaxCorp.BodySoft" />

    <Button
        android:id="@+id/btnLegalBack"
        style="@style/Widget.MaxCorp.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/button_back" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_playful_field"
        android:padding="8dp">

        <WebView
            android:id="@+id/legalWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_playful_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cabinet_title"
            style="@style/TextAppearance.MaxCorp.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cabinet_subtitle"
            style="@style/TextAppearance.MaxCorp.Subtitle" />

        <FrameLayout
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_section_badge"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/section_badge_cabinet"
                app:srcCompat="@drawable/ic_menu_cabinet"
                app:tint="@color/mc_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCabinetRobot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_playful_field"
            android:padding="16dp"
            android:textAppearance="@style/TextAppearance.MaxCorp.FieldValue" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaxCorp.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="@string/cabinet_hint_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCabinetName"
                style="@style/Widget.MaxCorp.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaxCorp.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cabinet_hint_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCabinetEmail"
                style="@style/Widget.MaxCorp.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaxCorp.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cabinet_hint_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCabinetPhone"
                style="@style/Widget.MaxCorp.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cabinet_label_plan"
            style="@style/TextAppearance.MaxCorp.SectionLabel" />

        <TextView
            android:id="@+id/tvCabinetPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_playful_field"
            android:padding="16dp"
            style="@style/TextAppearance.MaxCorp.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cabinet_label_dates"
            style="@style/TextAppearance.MaxCorp.SectionLabel" />

        <TextView
            android:id="@+id/tvCabinetDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_playful_field"
            android:padding="16dp"
            style="@style/TextAppearance.MaxCorp.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cabinet_label_payment"
            style="@style/TextAppearance.MaxCorp.SectionLabel" />

        <TextView
            android:id="@+id/tvCabinetPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_playful_field"
            android:padding="16dp"
            style="@style/TextAppearance.MaxCorp.Body" />

        <Button
            android:id="@+id/btnCabinetSave"
            style="@style/Widget.MaxCorp.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/button_save_changes" />

        <Button
            android:id="@+id/btnBackToMenu"
            style="@style/Widget.MaxCorp.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/button_back_to_menu" />

        <TextView
            android:id="@+id/tvCabinetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_playful_field"
            android:padding="16dp"
            android:text="@string/cabinet_status_ready"
            style="@style/TextAppearance.MaxCorp.BodySoft" />

    </LinearLayout>
</ScrollView>

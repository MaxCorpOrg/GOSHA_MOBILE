<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_playful_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guides_title"
            style="@style/TextAppearance.MaxCorp.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/guides_subtitle"
            style="@style/TextAppearance.MaxCorp.Subtitle" />

        <FrameLayout
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_section_badge"
            android:padding="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/section_badge_guides"
                app:srcCompat="@drawable/ic_menu_guides"
                app:tint="@color/mc_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_playful_card"
            android:padding="18dp"
            android:text="@string/guides_card_1"
            style="@style/TextAppearance.MaxCorp.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_playful_card"
            android:padding="18dp"
            android:text="@string/guides_card_2"
            style="@style/TextAppearance.MaxCorp.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_playful_card"
            android:padding="18dp"
            android:text="@string/guides_card_3"
            style="@style/TextAppearance.MaxCorp.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_playful_card"
            android:padding="18dp"
            android:text="@string/guides_card_4"
            style="@style/TextAppearance.MaxCorp.Body" />

        <Button
            android:id="@+id/btnBackToMenu"
            style="@style/Widget.MaxCorp.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/button_back_to_menu" />

    </LinearLayout>
</ScrollView>
